{
  "experiment": {
    "name": "pilot_lcbench_nocost_test8_noisy",
    "env_id": "CostAwareBO-YAHPO-LCBench",
    "seed": 1,
    "torch_deterministic": true,
    "cuda": true,
    "save_every": 250000,
    "checkpoint_dir": "checkpoints",
    "run_dir": "runs"
  },

  "ppo": {
    "total_timesteps": 262144,
    "learning_rate": 0.0001,
    "num_envs": 256,
    "num_steps": 32,
    "anneal_lr": true,
    "gamma": 1.0,
    "gae_lambda": 0.98,
    "num_minibatches": 4,
    "update_epochs": 4,
    "norm_adv": true,
    "clip_coef": 0.2,
    "clip_vloss": true,
    "ent_coef": 0.01,
    "vf_coef": 1.0,
    "max_grad_norm": 0.5,
    "target_kl": 0.3
  },

  "agent": {
    "num_layers": 3,
    "layer_size": 64
  },

  "env": {
    "device": "cuda",
    "dtype": "float32",
    "n_candidates": 64,
    "n_init": 3,
    "budget": 5000.0,
    "max_acquisitions": 30,
    "reward_type": "final_neglog_regret",
    "mask_visited_actions": false,
    "cost_feature_mode": "none",
    "objective_noise_std": 0.01,
    "objective_noise_clip": true
  },

  "candidate_set": {
    "type": "provided_by_problem"
  },

  "problem_family": {
    "type": "yahpo_lcbench",
    "instances": [
      "168331",
      "168335",
      "168868",
      "168908",
      "168910",
      "189354",
      "189862",
      "189865"
    ],
    "objective_key": "val_accuracy",
    "objective_scale": 0.01,
    "cost_key": "time",
    "epoch": 51
  },

  "gp": {
    "kernel": "matern52",
    "lr": 0.001,
    "training_iter": 10
  },

  "cost_model": {
    "type": "known",
    "target_transform": "log1p",
    "include_uncertainty": false
  }
}